# Rishabh Provision Store - Environment Variable Template

# Server Configuration
PORT=5001
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Database Connections
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rishabh_store?retryWrites=true&w=majority

# Redis & Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=

GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
