# Root Monorepo Environment Template

# Backend API Environment Variables (apps/server/.env)
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rishabh_provision_store?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEMINI_API_KEY=your_gemini_pro_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CLIENT_URL=http://localhost:5173

# Frontend Web Application Environment Variables (apps/web/.env)
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_APP_NAME="Rishabh Provision Store"
