# Environment Configuration Example for Rishabh Provision Store API

# Server Environment & Port
NODE_ENV=development
PORT=5001

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rishabh_provision_store?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# Cloudinary Storage Configuration (Product Images & Receipts)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI Assistant API Key (AI Search, Recommendations, Smart Reordering)
GEMINI_API_KEY=your_gemini_pro_api_key

# Razorpay Payment Gateway Keys (UPI, Cards, Net Banking)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS & Client Application URL
CLIENT_URL=http://localhost:5173
