# Server Microservice Environment Template
NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rishabh-provision-store?retryWrites=true&w=majority

JWT_SECRET=your_jwt_access_secret_256_bit
JWT_REFRESH_SECRET=your_jwt_refresh_secret_256_bit

# Cloudinary External Storage API Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
